<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calculator1.Calc"
             Title="Calc">
    <VerticalStackLayout>
        <Grid RowDefinitions="100,100,100,100,100" ColumnDefinitions="100,100,100,100,100" RowSpacing="8" ColumnSpacing="8" HorizontalOptions="Center">
            <Entry x:Name="Equastion" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"/>
            <Button BackgroundColor="Black" Clicked="Button_Clicked_Num" Text="7" Grid.Row="1" Grid.Column="0"/>
            <Button BackgroundColor="Black" Clicked="Button_Clicked_Num" Text="8" Grid.Row="1" Grid.Column="1"/>
            <Button BackgroundColor="Black" Clicked="Button_Clicked_Num" Text="9" Grid.Row="1" Grid.Column="2"/>
            <Button BackgroundColor="OrangeRed" TextColor="Black" Clicked="Button_Clicked_Task" Text="+" Grid.Row="1" Grid.Column="3"/>
            
            <Button BackgroundColor="Black" Clicked="Button_Clicked_Num" Text="4" Grid.Row="2" Grid.Column="0"/>
            <Button BackgroundColor="Black" Clicked="Button_Clicked_Num" Text="5" Grid.Row="2" Grid.Column="1"/>
            <Button BackgroundColor="Black" Clicked="Button_Clicked_Num" Text="6" Grid.Row="2" Grid.Column="2"/>
            <Button BackgroundColor="OrangeRed" TextColor="Black" Clicked="Button_Clicked_Task" Text="-" Grid.Row="2" Grid.Column="3"/>
            
            <Button BackgroundColor="Black" Clicked="Button_Clicked_Num" Text="1" Grid.Row="3" Grid.Column="0"/>
            <Button BackgroundColor="Black" Clicked="Button_Clicked_Num" Text="2" Grid.Row="3" Grid.Column="1"/>
            <Button BackgroundColor="Black" Clicked="Button_Clicked_Num" Text="3" Grid.Row="3" Grid.Column="2"/>
            <Button BackgroundColor="OrangeRed" TextColor="Black" Clicked="Button_Clicked_Task" Text="*" Grid.Row="3" Grid.Column="3"/>
            
            <Button BackgroundColor ="Grey" Clicked="Button_Clicked_AC" Text="ac" Grid.Row="4" Grid.Column="0"/>
            <Button BackgroundColor="Black" Clicked="Button_Clicked_Num" Text="0" Grid.Row="4" Grid.Column="1"/>
            <Button BackgroundColor ="Red" Clicked="Button_Clicked_Calculate" Text="=" Grid.Row="4" Grid.Column="2"/>
            <Button BackgroundColor="OrangeRed" TextColor="Black" Clicked="Button_Clicked_Num" Text="/" Grid.Row="4" Grid.Column="3"/>   
            
            
        </Grid>
    </VerticalStackLayout>
    
</ContentPage>